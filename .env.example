# Browser-safe Supabase project URL and PUBLISHABLE key only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only. Copy real connection strings from Supabase Connect.
# DATABASE_URL=postgresql://USER:PERCENT_ENCODED_PASSWORD@POOLER_HOST:6543/postgres
# DATABASE_MIGRATION_URL=postgresql://USER:PERCENT_ENCODED_PASSWORD@DIRECT_OR_SESSION_HOST:5432/postgres
DATABASE_URL=
DATABASE_MIGRATION_URL=

# Sandbox payment only. Server key and ticket encryption key stay server-only.
MIDTRANS_ENVIRONMENT=sandbox
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
TICKET_ENCRYPTION_KEY=

# Simple Helpdesk (server-only, never paste secrets into chat)
HELPDESK_COMPANY_ID=
HELPDESK_LINK_SECRET=
HELPDESK_PUBLIC_ORIGIN=http://localhost:3001
RESEND_API_KEY=
HELPDESK_EMAIL_FROM=
SUPABASE_SERVICE_ROLE_KEY=
# Enable only behind an ingress that overwrites x-real-ip. Public deployment requires this trusted identity; localhost development has a test-only shared limiter.
HELPDESK_TRUST_PROXY=false
